{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "lib": ["ES2022"],
    // `@cloudflare/vitest-pool-workers/types` fornisce i tipi del modulo virtuale
    // `cloudflare:test` (SELF, env), disponibile solo dentro workerd.
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["src/**/*"]
}
