{
  "expo": {
    "name": "JuTrack",
    "slug": "jutrack",
    "version": "0.1.0",
    "scheme": "jutrack",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frfal.jutrack"
    },
    "android": {
      "package": "com.frfal.jutrack",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA", "android.permission.POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "JuTrack usa la fotocamera solo per leggere il codice di collegamento fra i due telefoni.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#3B5BDB"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Balance",
              "label": "JuTrack — saldo",
              "description": "Quanto ti devono o quanto devi nel gruppo aperto.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            },
            {
              "name": "MonthTotal",
              "label": "JuTrack — speso questo mese",
              "description": "Il totale del mese in corso, nel gruppo aperto.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91640a35-dac1-4d52-be1d-938c17482d76"
      }
    },
    "owner": "frfal"
  }
}
