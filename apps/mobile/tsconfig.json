{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    // Per `node:sqlite`, usato dal solo adattatore di test in `src/testing/`. Porta con
    // sé i global di Node, che su Hermes non esistono tutti: la regola
    // `no-restricted-globals` in eslint.config.mjs li rimette fuori dal codice dell'app.
    "types": ["node"],
    // Per gli import fra i file di `scripts/`, che sono `.mts` eseguiti da `tsx` e
    // devono portare l'estensione. Innocuo per l'app: qui `tsc` non emette nulla — il
    // bundle lo fa Metro — e nessun file di `src/` importa con l'estensione.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
